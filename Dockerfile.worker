# Deploys the standalone BullMQ worker process (src/workers/index.ts) -
# Campaigns, Reminders, and Voice calls are processed here, separately from
# the Next.js web app. Needs a long-lived host (Railway/Render/Fly.io/Docker),
# not a serverless platform.
#
# Build:  docker build -f Dockerfile.worker -t evernaro-worker .
# Run:    docker run --env-file .env evernaro-worker
#
# Requires the same environment variables as the web app (DATABASE_URL,
# REDIS_URL, ENCRYPTION_KEY, channel provider keys, etc. - see .env.example).

FROM node:22-slim AS base
WORKDIR /app

# Install runtime deps for Prisma's query engine and dumb-init for clean signal
# handling (PID 1 receives SIGTERM and forwards it to Node).
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates dumb-init \
  && rm -rf /var/lib/apt/lists/*

FROM base AS deps
ENV NODE_ENV=development
COPY package.json package-lock.json ./
# tsx is needed at runtime to execute the TypeScript worker; it is listed under
# devDependencies, so we install all deps here.
RUN npm ci

FROM deps AS runner
# Generate the Prisma client before the source tree changes so Docker can cache
# this layer.
COPY prisma ./prisma
RUN npx prisma generate

COPY src ./src
COPY tsconfig.json ./

# Run as an unprivileged user - never as root in production.
RUN groupadd --system --gid 999 evernaro && \
    useradd --system --uid 999 --gid evernaro evernaro
USER evernaro

ENV WORKER_HEALTH_FILE=/tmp/worker.health

# If the worker hasn't updated its heartbeat file in 60 seconds, the container
# is unhealthy. The file is removed on graceful shutdown.
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
  CMD node -e "const fs=require('fs'); try { const t=Number(fs.readFileSync(process.env.WORKER_HEALTH_FILE,'utf8')); process.exit(Date.now()-t < 60000 ? 0 : 1); } catch { process.exit(1); }"

# dumb-init keeps signals working correctly when Node is not PID 1.
CMD ["dumb-init", "npx", "tsx", "src/workers/index.ts"]
