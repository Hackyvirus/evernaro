# =============================================================================
# Evernaro environment configuration
# =============================================================================
#
# Copy this file to .env and fill in the values. Variables are grouped by the
# platform/service that needs them.
#
# Platform tags:
#   [BOTH]     — required by Vercel (Next.js app) AND Render (worker)
#   [VERCEL]   — required by the Next.js app only
#   [RENDER]   — required by the worker only
#   [LOCAL]    — needed only for local development scripts
#   [OPTIONAL] — not required for the app to start; only enables integrations
#
# NEVER commit this file. .env is already gitignored.
# .env.example must contain NO real secrets.
# =============================================================================

# =============================================================================
# [BOTH] Core application — required by Vercel and Render
# =============================================================================

# PostgreSQL connection used by Prisma Client at runtime.
# For Neon: use the pooled connection string for DATABASE_URL.
DATABASE_URL="REPLACE_WITH_YOUR_VALUE"

# Direct PostgreSQL connection used by Prisma for migrations and introspection.
# For Neon: use the non-pooled connection string for DIRECT_URL.
DIRECT_URL="REPLACE_WITH_YOUR_VALUE"

# Redis connection used by BullMQ (queues) and the rate limiter.
# For Upstash: use the provided TLS URL with a password.
REDIS_URL="REPLACE_WITH_YOUR_VALUE"

# Public base URL of the deployment. Used to build every channel webhook URL.
# MUST match the actual public domain or inbound messages will never arrive.
NEXT_PUBLIC_BASE_URL="https://evernaro.com"

# Auth.js session signing key (32 random bytes, base64).
# Also used to derive webhook secrets. Rotating it invalidates all sessions.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="REPLACE_WITH_YOUR_VALUE"

# Encryption key for channel credentials stored in Postgres (32 random bytes, base64).
# Losing this key makes every stored credential unrecoverable.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY="REPLACE_WITH_YOUR_VALUE"

# =============================================================================
# [VERCEL] Next.js web application only
# =============================================================================

# Token to bootstrap the first platform admin at /platform/setup.
# Anyone with this token can create the first platform admin. Keep it secret.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PLATFORM_SETUP_TOKEN="REPLACE_WITH_YOUR_VALUE"

# Resend API key for outbound and transactional email.
RESEND_API_KEY="REPLACE_WITH_YOUR_VALUE"

# Default sender address for platform emails. Resend requires a verified domain.
EMAIL_FROM="Evernaro <noreply@evernaro.com>"

# Inbound email webhook shared secret. Must match the provider's webhook config.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
INBOUND_EMAIL_WEBHOOK_SECRET="REPLACE_WITH_YOUR_VALUE"

# Razorpay public key. Used server-side for orders/subscriptions.
RAZORPAY_KEY_ID="REPLACE_WITH_YOUR_VALUE"

# Razorpay public key exposed to the browser for Razorpay Checkout.
# Must match RAZORPAY_KEY_ID.
NEXT_PUBLIC_RAZORPAY_KEY_ID="REPLACE_WITH_YOUR_VALUE"

# Razorpay server-side secret. NEVER expose to the browser.
RAZORPAY_KEY_SECRET="REPLACE_WITH_YOUR_VALUE"

# Razorpay webhook verification secret configured in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET="REPLACE_WITH_YOUR_VALUE"

# AI provider selection: "openai" or "anthropic". AI is optional.
AI_PROVIDER="openai"

# OpenAI API key. Optional if Anthropic is used.
OPENAI_API_KEY="REPLACE_WITH_YOUR_VALUE"

# Anthropic API key. Optional if OpenAI is used.
ANTHROPIC_API_KEY="REPLACE_WITH_YOUR_VALUE"

# Optional AI model overrides. If omitted, sensible defaults are used.
OPENAI_MODEL=""
ANTHROPIC_MODEL=""

# Meta app secret for Instagram webhook signature verification. Optional.
META_APP_SECRET="REPLACE_WITH_YOUR_VALUE"

# Auth.js trustHost flag. Set to "true" in local development or when running
# behind a trusted reverse proxy.
AUTH_TRUST_HOST=""

# Optional: public URL for a demo booking page. If not set, the landing page
# demo link is hidden.
NEXT_PUBLIC_DEMO_BOOKING_URL=""

# =============================================================================
# [RENDER] Worker / background services only
# =============================================================================

# Path to the worker heartbeat file. Defaults to /tmp/worker.health.
WORKER_HEALTH_FILE="/tmp/worker.health"

# =============================================================================
# [BOTH] Optional tuning / safety limits
# =============================================================================

# Bulk campaign send rate (messages/second).
CAMPAIGN_RATE_PER_SECOND="5"

# BullMQ worker concurrency limits.
CAMPAIGN_WORKER_CONCURRENCY="5"
REMINDER_WORKER_CONCURRENCY="10"
NO_SHOW_WORKER_CONCURRENCY="20"

# Per-org active-user seat cap. Optional; defaults to 5.
SEAT_LIMIT="5"

# Per-org daily campaign recipient safety cap. Optional; defaults to 2000.
DAILY_CAMPAIGN_RECIPIENT_LIMIT="2000"

# Rate limiter fail-closed behavior. Optional; defaults to true.
# Set to "false" to allow requests when Redis is unavailable.
RATE_LIMIT_FAIL_CLOSED=""

# =============================================================================
# [BOTH] Optional monitoring
# =============================================================================

# Sentry server-side DSN. Optional; no-ops if not set.
SENTRY_DSN=""

# Sentry browser DSN. Optional; must be NEXT_PUBLIC_* for client-side Sentry.
NEXT_PUBLIC_SENTRY_DSN=""

# Sentry source-map upload configuration. Optional; only used at build time.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# =============================================================================
# [VERCEL] Docker / migration entrypoint
# =============================================================================

# When "true", the Docker web app entrypoint runs `prisma migrate deploy` before
# starting. Enable only on a single container to avoid migration races.
RUN_MIGRATIONS="false"

# =============================================================================
# [VERCEL] Optional external cron backup
# =============================================================================

# Secret for /api/cron/billing-run. The worker already schedules billing runs,
# so this is only a backup mechanism.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=""

# =============================================================================
# [LOCAL] Local development scripts only
# =============================================================================

# Used by scripts/seed-demo-account.ts to create demo accounts. NEVER use these
# in production.
DEMO_PASSWORD="DemoPass1234"
DEMO_PLATFORM_ADMIN_EMAIL="admin-demo@evernaro.com"
DEMO_PLATFORM_ADMIN_PASSWORD="DemoAdmin1234"

# Used by scripts/reset-platform-admin.mjs when resetting a platform admin.
NEW_ADMIN_PASSWORD=""

# =============================================================================
# Build-time variables
# =============================================================================

# Set to "true" in Docker builds to enable Next.js standalone output.
# Automatically set inside Dockerfile; no need to set manually.
DOCKER_BUILD=""
