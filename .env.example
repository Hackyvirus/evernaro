# Neon Postgres — create a database and paste both connection strings from
# the Neon dashboard (pooled for DATABASE_URL, direct for DIRECT_URL).
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require&pgbouncer=true&connection_limit=5&pool_timeout=20"
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require"

# Platform admin bootstrap token. Anyone with this token can create the first
# platform admin. Generate a strong random value and keep it secret.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PLATFORM_SETUP_TOKEN=""

# Auth.js — random 32-byte key, signs sessions and derives webhook secrets.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this invalidates all existing session cookies (users just log back in)
# and all previously-issued webhook secrets (Telegram/WhatsApp/Instagram/Voice
# channels will need to be reconnected so their webhook URLs pick up new secrets).
AUTH_SECRET=""

# AI draft-reply engine — provider is selected via AI_PROVIDER (openai | anthropic)
AI_PROVIDER="openai"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Resend (outbound email) — platform-level fallback key
RESEND_API_KEY=""
FROM_EMAIL="hello@evernaro.com"

# Public base URL — used to build every channel's webhook URLs (Telegram,
# WhatsApp, Instagram, Voice). MUST match the actual publicly-reachable URL
# this app is running at, or no inbound webhook will ever be reached —
# update this before connecting any channel in a new environment.
NEXT_PUBLIC_BASE_URL="https://evernaro.com"

# Shared secret to authenticate inbound email webhooks (e.g. Resend/Postmark inbound)
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
INBOUND_EMAIL_WEBHOOK_SECRET=""

# Redis (BullMQ job queue — bulk campaigns + reminders). Local dev default.
REDIS_URL="redis://localhost:6379"

# Encrypts channel credentials (bot tokens, API keys) at rest in Postgres —
# a DB-level compromise alone should not hand over live third-party
# credentials in cleartext. 32 random bytes, base64. Losing this key makes
# every stored credential unrecoverable — every channel would need reconnecting.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# Bulk campaign send rate (messages/second) — keep conservative for provider rate limits
CAMPAIGN_RATE_PER_SECOND="5"

# BullMQ worker concurrency — how many campaign/reminder jobs run in parallel.
CAMPAIGN_WORKER_CONCURRENCY="5"
REMINDER_WORKER_CONCURRENCY="10"

# Per-org active-user seat cap — guards against one org adding unlimited team
# members on a fixed plan. Optional; defaults to 5.
SEAT_LIMIT="5"

# Docker entrypoint only: when true, the app container runs `prisma migrate deploy`
# before starting the server. Disable when running multiple app replicas to avoid
# migration races; run migrations from a single one-off container instead.
RUN_MIGRATIONS="false"

# Error monitoring (Sentry) — optional, everything no-ops safely without it.
# Create a free project at sentry.io, then set:
#   SENTRY_DSN / NEXT_PUBLIC_SENTRY_DSN — same value, one for server, one for browser
#   SENTRY_ORG, SENTRY_PROJECT, SENTRY_AUTH_TOKEN — only needed for source-map upload at build time
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Per-org daily campaign recipient cap — guards against one org running
# unbounded WhatsApp/Twilio/OpenAI spend. Optional; defaults to 2000/day.
DAILY_CAMPAIGN_RECIPIENT_LIMIT="2000"

# Billing (Razorpay) — optional, everything no-ops safely without it (a
# platform admin can still create invoices, they just won't have a payable
# order until this is set). Get keys from the Razorpay dashboard:
#   RAZORPAY_KEY_ID / NEXT_PUBLIC_RAZORPAY_KEY_ID — same value, one for server, one for browser Checkout
#   RAZORPAY_KEY_SECRET — server-side only, never expose this
#   RAZORPAY_WEBHOOK_SECRET — separate secret set when configuring the webhook URL in the Razorpay dashboard
RAZORPAY_KEY_ID=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
